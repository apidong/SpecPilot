# apps/api Environment Configuration
# Copy to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=specpilot_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker
WORKER_SECRET=your-super-secret-worker-key-change-in-production

# Storage
WORKSPACE_ROOT=./storage/app/workspaces

# CORS
CORS_ORIGIN=http://localhost:5173

# LLM (default)
LLM_DEFAULT_PROVIDER=openai_compatible
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_API_KEY=
