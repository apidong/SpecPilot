# apps/worker Environment Configuration (Optional)
# Copy to .env to override defaults
# If not set, worker uses defaults from src/config/paths.ts

# Worker Secret (REQUIRED — must match API's WORKER_SECRET)
WORKER_SECRET=your-super-secret-worker-key-change-in-production

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Internal API Callback URL
# Used to POST execution logs, file changes, and execution status
INTERNAL_API_URL=http://localhost:3000

# Workspace Root (git worktree storage location)
# Defaults to ./storage/app/workspaces
WORKSPACE_ROOT=./storage/app/workspaces
